{
  "name": "automatizacion",
  "productName": "Automatizacion",
  "version": "0.22.0",
  "description": "Práctica de programación de autómatas en KOP y AWL con mini simulador de PLC",
  "author": "Arzath",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:diff": "DIFF=1 vitest run tests/core/differential.test.ts",
    "e2e": "playwright test",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "dist:dev": "npm run dist && node scripts/publicar.mjs dev",
    "publicar:prod": "node scripts/publicar.mjs prod"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "codemirror": "6.0.2",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "immer": "11.1.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
